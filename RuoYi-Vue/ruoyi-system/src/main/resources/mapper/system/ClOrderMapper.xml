<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.system.mapper.ClOrderMapper">
    
    <resultMap type="ClOrder" id="ClOrderResult">
        <result property="orderId"    column="order_id"    />
        <result property="orderNo"    column="order_no"    />
        <result property="deviceId"    column="device_id"    />
        <result property="orderType"    column="order_type"    />
        <result property="totalAmount"    column="total_amount"    />
        <result property="status"    column="status"    />
        <result property="cancelStatus"    column="cancel_status"    />
        <result property="cancelReason"    column="cancel_reason"    />
        <result property="receiverName"    column="receiver_name"    />
        <result property="receiverPhone"    column="receiver_phone"    />
        <result property="receiverAddress"    column="receiver_address"    />
        <result property="createBy"    column="create_by"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateBy"    column="update_by"    />
        <result property="updateTime"    column="update_time"    />
        <result property="remark"    column="remark"    />
    </resultMap>

    <sql id="selectClOrderVo">
        select order_id, order_no, device_id, order_type, total_amount, status, cancel_status, cancel_reason, receiver_name, receiver_phone, receiver_address, create_by, create_time, update_by, update_time, remark from cl_order
    </sql>

    <select id="selectClOrderList" parameterType="ClOrder" resultMap="ClOrderResult">
        <include refid="selectClOrderVo"/>
        <where>  
            <if test="orderNo != null  and orderNo != ''"> and order_no = #{orderNo}</if>
            <if test="deviceId != null  and deviceId != ''"> and device_id = #{deviceId}</if>
            <if test="orderType != null  and orderType != ''"> and order_type = #{orderType}</if>
            <if test="status != null  and status != ''"> and status = #{status}</if>
            <if test="receiverName != null  and receiverName != ''"> and receiver_name like concat('%', #{receiverName}, '%')</if>
            <if test="receiverPhone != null  and receiverPhone != ''"> and receiver_phone = #{receiverPhone}</if>
            <if test="receiverAddress != null  and receiverAddress != ''"> and receiver_address like concat('%', #{receiverAddress}, '%')</if>
        </where>
    </select>
    
    <select id="selectClOrderByOrderId" parameterType="Long" resultMap="ClOrderResult">
        <include refid="selectClOrderVo"/>
        where order_id = #{orderId}
    </select>

    <insert id="insertClOrder" parameterType="ClOrder" useGeneratedKeys="true" keyProperty="orderId">
        insert into cl_order
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="orderNo != null and orderNo != ''">order_no,</if>
            <if test="deviceId != null and deviceId != ''">device_id,</if>
            <if test="orderType != null and orderType != ''">order_type,</if>
            <if test="totalAmount != null">total_amount,</if>
            <if test="status != null and status != ''">status,</if>
            <if test="receiverName != null and receiverName != ''">receiver_name,</if>
            <if test="receiverPhone != null and receiverPhone != ''">receiver_phone,</if>
            <if test="receiverAddress != null and receiverAddress != ''">receiver_address,</if>
            <if test="createBy != null">create_by,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateBy != null">update_by,</if>
            <if test="updateTime != null">update_time,</if>
            <if test="remark != null">remark,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="orderNo != null and orderNo != ''">#{orderNo},</if>
            <if test="deviceId != null and deviceId != ''">#{deviceId},</if>
            <if test="orderType != null and orderType != ''">#{orderType},</if>
            <if test="totalAmount != null">#{totalAmount},</if>
            <if test="status != null and status != ''">#{status},</if>
            <if test="receiverName != null and receiverName != ''">#{receiverName},</if>
            <if test="receiverPhone != null and receiverPhone != ''">#{receiverPhone},</if>
            <if test="receiverAddress != null and receiverAddress != ''">#{receiverAddress},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateBy != null">#{updateBy},</if>
            <if test="updateTime != null">#{updateTime},</if>
            <if test="remark != null">#{remark},</if>
         </trim>
    </insert>

    <update id="updateClOrder" parameterType="ClOrder">
        update cl_order
        <trim prefix="SET" suffixOverrides=",">
            <if test="orderNo != null and orderNo != ''">order_no = #{orderNo},</if>
            <if test="deviceId != null and deviceId != ''">device_id = #{deviceId},</if>
            <if test="orderType != null and orderType != ''">order_type = #{orderType},</if>
            <if test="totalAmount != null">total_amount = #{totalAmount},</if>
            <if test="status != null and status != ''">status = #{status},</if>
            <if test="cancelStatus != null and cancelStatus != ''">cancel_status = #{cancelStatus},</if>
            <if test="cancelReason != null">cancel_reason = #{cancelReason},</if>
            <if test="receiverName != null and receiverName != ''">receiver_name = #{receiverName},</if>
            <if test="receiverPhone != null and receiverPhone != ''">receiver_phone = #{receiverPhone},</if>
            <if test="receiverAddress != null and receiverAddress != ''">receiver_address = #{receiverAddress},</if>
            <if test="createBy != null">create_by = #{createBy},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
            <if test="remark != null">remark = #{remark},</if>
        </trim>
        where order_id = #{orderId}
    </update>

    <delete id="deleteClOrderByOrderId" parameterType="Long">
        delete from cl_order where order_id = #{orderId}
    </delete>

    <delete id="deleteClOrderByOrderIds" parameterType="String">
        delete from cl_order where order_id in 
        <foreach item="orderId" collection="array" open="(" separator="," close=")">
            #{orderId}
        </foreach>
    </delete>

    <!-- 获取今天的订单数量 -->
    <select id="getTodayOrderCount" resultType="int">
        select count(*) from cl_order 
        where DATE(create_time) = CURDATE()
    </select>

    <!-- 获取最大订单号 -->
    <select id="getMaxOrderNo" resultType="String">
        select order_no from cl_order 
        order by order_id desc 
        limit 1
    </select>
</mapper>