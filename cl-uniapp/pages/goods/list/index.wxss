/* 商品列表页面样式 */

.container {
  background: #f5f5f5;
  min-height: 100vh;
  padding: 20rpx;
}

.search-bar {
  display: flex;
  margin-bottom: 20rpx;
  gap: 10rpx;
}

.search-input {
  flex: 1;
  background: white;
  border: 1px solid #ddd;
  border-radius: 5rpx;
  padding: 10rpx 15rpx;
  font-size: 28rpx;
}

.search-btn {
  width: 100rpx;
  height: 60rpx;
  background: #c33c2f;
  color: white;
  border-radius: 5rpx;
  font-size: 26rpx;
  line-height: 60rpx;
  padding: 0;
}

.goods-list {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
}

.goods-item {
  width: 48%;
  background: white;
  border-radius: 10rpx;
  margin-bottom: 20rpx;
  overflow: hidden;
}

.goods-image {
  width: 100%;
  height: 300rpx;
  display: block;
}

.goods-info {
  padding: 20rpx;
}

.goods-name {
  font-size: 28rpx;
  color: #333;
  display: block;
  margin-bottom: 10rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.goods-price {
  font-size: 32rpx;
  color: #c33c2f;
  font-weight: bold;
  display: block;
  margin-bottom: 10rpx;
}

.goods-stock {
  font-size: 24rpx;
  color: #999;
  display: block;
}

.empty,
.loading {
  text-align: center;
  padding: 100rpx 0;
  color: #999;
}
