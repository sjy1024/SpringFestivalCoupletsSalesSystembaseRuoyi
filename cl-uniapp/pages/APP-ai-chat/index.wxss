/* AI对话页面 */
.ai-chat-page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: #f5f5f5;
  box-sizing: border-box;
}

.ai-status-bar {
  flex-shrink: 0;
  padding: 12rpx 20rpx;
  background: #fff;
  border-bottom: 1rpx solid #eee;
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 12rpx;
}

.status-pill {
  font-size: 22rpx;
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
  color: #fff;
}

.status-pill.on {
  background: #2e7d32;
}

.status-pill.off {
  background: #999;
}

.status-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-left: auto;
}

.mini-btn {
  margin: 0;
  padding: 0 16rpx;
  font-size: 22rpx;
  line-height: 1.8;
  background: #f0f0f0;
  color: #333;
}

.mini-btn.history-btn {
  padding: 0 20rpx;
  font-size: 24rpx;
  font-weight: 600;
  color: #c41e3a;
  background: #fff4f4;
  border: 1rpx solid #f0c0c0;
}

.mini-btn.danger {
  background: #ffebee;
  color: #c62828;
}

.chat-scroll {
  flex: 1;
  height: 0;
  min-height: 200rpx;
}

.chat-inner {
  padding: 16rpx 20rpx 24rpx;
}

.msg-row {
  margin-bottom: 16rpx;
}

.system-msg {
  align-self: center;
  background: rgba(0, 0, 0, 0.06);
  padding: 10rpx 20rpx;
  border-radius: 12rpx;
  font-size: 22rpx;
  color: #666;
  text-align: center;
}

.ai-row,
.user-row {
  display: flex;
  align-items: flex-end;
  gap: 12rpx;
}

.user-row {
  flex-direction: row;
  justify-content: flex-end;
}

.avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  font-weight: 600;
  color: #fff;
}

.ai-avatar {
  background: linear-gradient(135deg, #c41e3a, #e57373);
}

.user-avatar {
  background: linear-gradient(135deg, #1565c0, #64b5f6);
}

.bubble {
  max-width: 72%;
  padding: 16rpx 20rpx;
  border-radius: 20rpx;
  box-sizing: border-box;
}

.ai-bubble {
  background: #fff;
  border-radius: 20rpx 20rpx 20rpx 6rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.06);
}

.user-bubble {
  background: #c41e3a;
  border-radius: 20rpx 20rpx 6rpx 20rpx;
}

.bubble-text {
  font-size: 28rpx;
  line-height: 1.55;
  white-space: pre-wrap;
  word-break: break-word;
}

.bubble-rich-text {
  display: block;
  font-size: 28rpx;
  line-height: 1.55;
  word-break: break-word;
  color: #333;
}

.ai-bubble .bubble-text {
  color: #333;
}

.user-bubble .bubble-text {
  color: #fff;
}

.bubble-meta {
  margin-top: 8rpx;
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.bubble-time {
  font-size: 20rpx;
  color: #999;
}

.user-bubble .bubble-time {
  color: rgba(255, 255, 255, 0.75);
}

.llm-tag {
  font-size: 18rpx;
  color: #2e7d32;
  background: #e8f5e9;
  padding: 2rpx 8rpx;
  border-radius: 6rpx;
}

.bubble-actions {
  margin-top: 12rpx;
  padding-top: 10rpx;
  border-top: 1rpx dashed #eee;
}

.apply-chip {
  display: inline-block;
  font-size: 22rpx;
  color: #c41e3a;
  background: #fff5f5;
  padding: 6rpx 18rpx;
  border-radius: 999rpx;
  border: 1rpx solid #f5c6cb;
}

.chip.topic-chip {
  background: #fff5f5;
  color: #c41e3a;
  border: 1rpx solid #f5c6cb;
}

.chip.classic-chip {
  background: #fff8e1;
  color: #e65100;
  border: 1rpx solid #ffe082;
}

.classic-strip {
  padding-top: 0;
  border-top: none;
}

.typing-hint {
  text-align: center;
  font-size: 24rpx;
  color: #888;
  padding: 8rpx 0;
}

.bottom-anchor {
  height: 1rpx;
  width: 100%;
}

.ai-to-custom-bar {
  flex-shrink: 0;
  display: flex;
  flex-direction: column;
  align-items: stretch;
  gap: 8rpx;
  padding: 12rpx 20rpx;
  background: #fffaf5;
  border-top: 1rpx solid #f0e0d8;
}

.ai-fill-custom-btn {
  margin: 0;
  background: #c41e3a;
  color: #fff;
  font-size: 28rpx;
  border-radius: 12rpx;
}

.ai-fill-custom-hint {
  font-size: 22rpx;
  color: #888;
  text-align: center;
}

.recommend-strip {
  flex-shrink: 0;
  background: #fff;
  border-top: 1rpx solid #eee;
  padding: 12rpx 0 8rpx;
}

.strip-title {
  font-size: 24rpx;
  font-weight: 600;
  color: #333;
  padding: 0 20rpx 8rpx;
}

.strip-scroll {
  white-space: nowrap;
  width: 100%;
}

.strip-inner,
.quick-inner {
  display: inline-flex;
  gap: 12rpx;
  padding: 0 20rpx 8rpx;
}

.chip {
  display: inline-block;
  padding: 10rpx 22rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  background: #f5f5f5;
  color: #555;
}

.chip.ghost {
  background: #fafafa;
  border: 1rpx solid #e0e0e0;
}

.input-area {
  flex-shrink: 0;
  background: #fff;
  border-top: 1rpx solid #e5e5e5;
  padding: 12rpx 16rpx calc(12rpx + env(safe-area-inset-bottom));
  box-shadow: 0 -4rpx 12rpx rgba(0, 0, 0, 0.04);
}

.input-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.message-input {
  flex: 1;
  height: 72rpx;
  padding: 0 24rpx;
  border: 1rpx solid #e0e0e0;
  border-radius: 36rpx;
  font-size: 28rpx;
  background: #fafafa;
  box-sizing: border-box;
}

.send-btn {
  width: 120rpx;
  height: 72rpx;
  line-height: 72rpx;
  padding: 0;
  margin: 0;
  background: #c41e3a;
  color: #fff;
  font-size: 28rpx;
  border-radius: 36rpx;
  font-weight: 600;
}

.send-btn[disabled] {
  opacity: 0.6;
}

.quick-scroll {
  margin-top: 10rpx;
  white-space: nowrap;
  width: 100%;
}
