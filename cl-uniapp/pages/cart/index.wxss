/* 购物车页面样式 */
.container {
  padding: 20rpx;
  padding-bottom: 20rpx;
  min-height: 100vh;
  display: flex;
  flex-direction: column;
}

.header {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

.section {
  margin-bottom: 24rpx;
}

.section-header {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.section-count {
  font-size: 26rpx;
  color: #999;
  margin-left: 8rpx;
}

.custom-list {
  background: #fff;
  border-radius: 16rpx;
  overflow: hidden;
}

.custom-item {
  display: flex;
  align-items: center;
  padding: 24rpx 20rpx;
  border-bottom: 1rpx solid #f5f5f5;
}

.custom-item:last-child {
  border-bottom: none;
}

.custom-icon {
  width: 72rpx;
  height: 72rpx;
  border-radius: 12rpx;
  background: linear-gradient(135deg, #ff6b6b, #c41e3a);
  color: #fff;
  font-size: 32rpx;
  font-weight: bold;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.custom-body {
  flex: 1;
  min-width: 0;
}

.custom-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 8rpx;
}

.custom-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  margin-right: 16rpx;
}

.custom-status {
  font-size: 22rpx;
  padding: 4rpx 12rpx;
  border-radius: 20rpx;
  flex-shrink: 0;
}

.status-pending {
  color: #ff8800;
  background: #fff4e6;
}

.status-making {
  color: #1890ff;
  background: #e6f4ff;
}

.status-done {
  color: #52c41a;
  background: #f6ffed;
}

.status-canceled {
  color: #999;
  background: #f5f5f5;
}

.status-cancel-pending {
  color: #fa8c16;
  background: #fff7e6;
}

.custom-couplet {
  display: block;
  font-size: 24rpx;
  color: #666;
  line-height: 1.5;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.custom-meta {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-top: 10rpx;
  font-size: 22rpx;
  color: #999;
}

.custom-meta text:first-child {
  color: #ff4444;
  font-weight: bold;
  font-size: 28rpx;
}

.custom-arrow {
  font-size: 36rpx;
  color: #ccc;
  margin-left: 12rpx;
}

.title {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
}

.count {
  font-size: 28rpx;
  color: #999;
  margin-left: 10rpx;
}

.cart-list {
  background: #fff;
  border-radius: 10rpx;
}

.cart-item {
  display: flex;
  align-items: center;
  padding: 20rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.cart-item:last-child {
  border-bottom: none;
}

.select-box {
  margin-right: 20rpx;
  padding: 10rpx;
}

.checkbox {
  width: 40rpx;
  height: 40rpx;
  border: 3rpx solid #ddd;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #fff;
  transition: all 0.3s ease;
}

.checkbox.checked {
  background: #ff4444;
  border-color: #ff4444;
  transform: scale(1.1);
}

.check-icon {
  color: #fff;
  font-size: 24rpx;
  font-weight: bold;
}

.goods-info {
  flex: 1;
  display: flex;
  margin-right: 20rpx;
}

.goods-image {
  width: 120rpx;
  height: 120rpx;
  border-radius: 10rpx;
  margin-right: 20rpx;
}

.goods-detail {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.goods-name {
  font-size: 28rpx;
  color: #333;
  line-height: 1.4;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.goods-spec {
  font-size: 24rpx;
  color: #999;
  display: block;
  margin-top: 6rpx;
}

.goods-price {
  font-size: 32rpx;
  color: #ff4444;
  font-weight: bold;
}

.goods-stock {
  font-size: 24rpx;
  color: #999;
}

.quantity-control {
  display: flex;
  align-items: center;
  margin-right: 20rpx;
}

.btn {
  width: 60rpx;
  height: 60rpx;
  border: 1rpx solid #ddd;
  background: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  color: #333;
}

.btn.decrease {
  border-radius: 10rpx 0 0 10rpx;
}

.btn.increase {
  border-radius: 0 10rpx 10rpx 0;
}

.btn:disabled {
  background: #f5f5f5;
  color: #ccc;
}

.quantity {
  width: 80rpx;
  height: 60rpx;
  border: 1rpx solid #ddd;
  border-left: none;
  border-right: none;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  background: #fff;
}

.delete-btn {
  padding: 10rpx;
}

.delete-icon {
  font-size: 32rpx;
}

.empty-page {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 70vh;
  padding: 40rpx 30rpx 120rpx;
  box-sizing: border-box;
}

.empty-action {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 20rpx;
  margin-top: 32rpx;
}

.cart-goods-empty {
  background: #fff;
  border-radius: 16rpx;
  padding: 48rpx 30rpx;
  text-align: center;
}

.cart-goods-empty__text {
  display: block;
  font-size: 28rpx;
  color: #999;
  margin-bottom: 24rpx;
}

.go-shopping-btn.mini {
  display: inline-block;
  padding: 16rpx 48rpx;
  font-size: 26rpx;
}

.empty-cart {
  text-align: center;
  padding: 100rpx 0;
}

.empty-text {
  font-size: 32rpx;
  color: #666;
  display: block;
  margin-bottom: 20rpx;
}

.empty-desc {
  font-size: 28rpx;
  color: #999;
  display: block;
  margin-bottom: 40rpx;
}

.empty-actions {
  display: flex;
  justify-content: center;
  gap: 24rpx;
}

.go-shopping-btn {
  background: #ff4444;
  color: #fff;
  border-radius: 50rpx;
  padding: 20rpx 60rpx;
  font-size: 28rpx;
  line-height: 1.4;
}

.go-shopping-btn::after {
  border: none;
}

.go-custom-btn {
  background: #fff;
  color: #c41e3a;
  border: 2rpx solid #c41e3a;
  border-radius: 50rpx;
  padding: 20rpx 60rpx;
  font-size: 28rpx;
  line-height: 1.4;
}

.go-custom-btn::after {
  border: none;
}

.loading {
  text-align: center;
  padding: 40rpx 0;
  color: #999;
}

.footer {
  position: fixed;
  left: 0;
  right: 0;
  bottom: calc(140rpx + constant(safe-area-inset-bottom));
  bottom: calc(140rpx + env(safe-area-inset-bottom));
  background: #fff;
  border-top: 1rpx solid #f0f0f0;
  padding: 20rpx 24rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  z-index: 100;
  box-sizing: border-box;
  box-shadow: 0 -4rpx 20rpx rgba(0, 0, 0, 0.06);
}

.left-section {
  display: flex;
  align-items: center;
}

.select-all {
  display: flex;
  align-items: center;
  margin-right: 30rpx;
}

.select-all-text {
  font-size: 28rpx;
  color: #333;
  margin-left: 10rpx;
}

.right-section {
  display: flex;
  align-items: center;
}

.total-info {
  margin-right: 20rpx;
}

.total-text {
  font-size: 28rpx;
  color: #333;
}

.total-amount {
  font-size: 32rpx;
  color: #ff4444;
  font-weight: bold;
}

.checkout-btn {
  background: #ccc;
  color: #fff;
  border-radius: 50rpx;
  padding: 20rpx 40rpx;
  font-size: 28rpx;
}
.checkout-btn.active {
  background: #ff4444;
}

.checkout-btn:disabled {
  background: #ccc;
}

.footer-placeholder {
  height: calc(280rpx + constant(safe-area-inset-bottom));
  height: calc(280rpx + env(safe-area-inset-bottom));
}
