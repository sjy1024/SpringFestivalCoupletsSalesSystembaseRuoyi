.custom-page {
  min-height: 100vh;
  background: #f5f6f8;
  padding: 20rpx 20rpx 280rpx;
  box-sizing: border-box;
}

.card-section {
  background: #fff;
  border-radius: 20rpx;
  margin-bottom: 20rpx;
  padding: 24rpx 0;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.04);
}

.section-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #222;
  margin-bottom: 20rpx;
  padding: 0 24rpx;
}

.section-title--inline {
  margin-bottom: 0;
  padding: 0;
}

/* AI 顶部卡片 */
.ai-hero {
  background: linear-gradient(145deg, #fff5f2 0%, #ffffff 50%, #fff8f5 100%);
  border: 2rpx solid rgba(196, 30, 58, 0.2);
  border-radius: 24rpx;
  padding: 28rpx 28rpx 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 12rpx 36rpx rgba(196, 30, 58, 0.1);
}

.ai-hero-top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 12rpx;
}

.ai-hero-title-wrap {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.ai-hero-title {
  font-size: 36rpx;
  font-weight: 800;
  color: #8b1538;
}

.ai-hero-badge {
  font-size: 20rpx;
  font-weight: 700;
  color: #fff;
  background: linear-gradient(135deg, #c41e3a, #e85d6f);
  padding: 6rpx 14rpx;
  border-radius: 10rpx;
}

.ai-status {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 22rpx;
  color: #999;
  flex-shrink: 0;
}

.ai-status.online {
  color: #16a34a;
}

.ai-status-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #ccc;
}

.ai-status.online .ai-status-dot {
  background: #22c55e;
  box-shadow: 0 0 8rpx rgba(34, 197, 94, 0.6);
}

.ai-hero-desc {
  display: block;
  font-size: 26rpx;
  color: #444;
  line-height: 1.5;
  margin-bottom: 8rpx;
}

.ai-hero-tip {
  display: block;
  font-size: 22rpx;
  color: #888;
  line-height: 1.45;
  margin-bottom: 20rpx;
}

.ai-hero-action {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-top: 16rpx;
  border-top: 1rpx solid rgba(196, 30, 58, 0.12);
  font-size: 28rpx;
  font-weight: 700;
  color: #c41e3a;
}

.ai-hero-arrow {
  font-size: 40rpx;
  line-height: 1;
  font-weight: 300;
}

/* 主题快捷生成 */
.ai-theme-section {
  margin-bottom: 20rpx;
  padding: 0 4rpx;
}

.ai-theme-label {
  font-size: 24rpx;
  color: #666;
  margin-bottom: 14rpx;
}

.ai-theme-list {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
}

.ai-theme-chip {
  padding: 12rpx 22rpx;
  font-size: 24rpx;
  color: #8b1538;
  background: #fff;
  border: 1rpx solid rgba(196, 30, 58, 0.25);
  border-radius: 999rpx;
}

.ai-theme-chip.disabled {
  opacity: 0.5;
}

/* 定制类型 */
.type-options {
  display: flex;
  padding: 0 24rpx;
  gap: 16rpx;
}

.type-item {
  flex: 1;
  text-align: center;
  padding: 16rpx 12rpx;
  border-radius: 16rpx;
  border: 2rpx solid #eee;
  transition: all 0.2s;
}

.type-item.active {
  border-color: #c41e3a;
  background: rgba(196, 30, 58, 0.05);
}

.type-image {
  width: 110rpx;
  height: 110rpx;
  margin: 0 auto 10rpx;
  border-radius: 12rpx;
  overflow: hidden;
  background: #f5f5f5;
}

.type-image image {
  width: 100%;
  height: 100%;
}

.type-name {
  font-size: 24rpx;
  color: #333;
  font-weight: 500;
}

/* 尺寸 */
.size-options {
  display: flex;
  flex-wrap: wrap;
  padding: 0 24rpx;
  gap: 14rpx;
}

.size-item {
  flex: 1;
  min-width: 140rpx;
  padding: 22rpx 12rpx;
  text-align: center;
  border-radius: 14rpx;
  border: 2rpx solid #eee;
}

.size-item.active {
  border-color: #c41e3a;
  background: rgba(196, 30, 58, 0.05);
}

.size-name {
  font-size: 26rpx;
  color: #333;
  margin-bottom: 6rpx;
  font-weight: 500;
}

.size-price {
  font-size: 24rpx;
  color: #c41e3a;
  font-weight: 700;
}

/* 联纸 */
.paper-options {
  display: flex;
  padding: 0 24rpx;
  gap: 14rpx;
}

.paper-item {
  flex: 1;
  padding: 20rpx 12rpx;
  text-align: center;
  border-radius: 14rpx;
  border: 2rpx solid #eee;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}

.paper-item.active {
  border-color: #c41e3a;
  background: rgba(196, 30, 58, 0.05);
}

.paper-color {
  width: 44rpx;
  height: 44rpx;
  border-radius: 10rpx;
  border: 2rpx solid rgba(0, 0, 0, 0.06);
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.08);
}

.paper-name {
  font-size: 24rpx;
  color: #333;
}

.paper-price {
  font-size: 22rpx;
  color: #c41e3a;
  font-weight: 600;
}

/* 文字内容 */
.content-section {
  padding: 24rpx;
}

.content-section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.ai-text-shortcut {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  padding: 10rpx 20rpx;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #fff0e8, #ffe4dc);
  border: 1rpx solid rgba(196, 30, 58, 0.3);
}

.ai-text-shortcut.loading {
  opacity: 0.7;
}

.ai-text-shortcut-tag {
  font-size: 20rpx;
  font-weight: 700;
  color: #fff;
  background: #c41e3a;
  padding: 4rpx 10rpx;
  border-radius: 8rpx;
}

.ai-text-shortcut-text {
  font-size: 24rpx;
  font-weight: 600;
  color: #8b1538;
}

.couplet-preview {
  background: linear-gradient(180deg, #fff9f5 0%, #fff 100%);
  border: 1rpx solid rgba(196, 30, 58, 0.15);
  border-radius: 16rpx;
  padding: 24rpx 28rpx;
  margin-bottom: 24rpx;
  text-align: center;
}

.couplet-preview-title {
  font-size: 22rpx;
  color: #999;
  margin-bottom: 16rpx;
}

.couplet-preview-line {
  font-size: 28rpx;
  color: #8b1538;
  font-weight: 600;
  line-height: 1.8;
  letter-spacing: 2rpx;
}

.hengpi-line {
  font-size: 32rpx;
  margin-bottom: 8rpx;
}

.input-item {
  margin-bottom: 22rpx;
}

.input-label {
  font-size: 26rpx;
  color: #333;
  margin-bottom: 10rpx;
  font-weight: 500;
}

.label-optional {
  font-size: 22rpx;
  color: #999;
  font-weight: 400;
  margin-left: 8rpx;
}

.input-textarea {
  width: 100%;
  height: 120rpx;
  padding: 18rpx;
  border: 2rpx solid #eee;
  border-radius: 14rpx;
  font-size: 26rpx;
  line-height: 1.5;
  background: #fafafa;
  box-sizing: border-box;
}

.input-textarea--short {
  height: 96rpx;
}

.input-hint {
  font-size: 20rpx;
  color: #aaa;
  text-align: right;
  margin-top: 6rpx;
}

/* 错误与订单绑定 */
.error-message {
  background: #fff1f0;
  border-left: 6rpx solid #ff4d4f;
  padding: 16rpx 20rpx;
  margin-bottom: 20rpx;
  border-radius: 12rpx;
}

.error-message text {
  font-size: 24rpx;
  color: #ff4d4f;
}

.order-bind-banner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
  padding: 18rpx 22rpx;
  background: linear-gradient(90deg, #fff8e6, #ffe8cc);
  border-radius: 14rpx;
  border: 1rpx solid #ffc266;
}

.order-bind-text {
  flex: 1;
  font-size: 24rpx;
  color: #663c00;
}

.order-bind-clear {
  font-size: 24rpx;
  color: #c41e3a;
  text-decoration: underline;
}

/* 底部 */
.bottom-section {
  position: fixed;
  bottom: 100rpx;
  left: 0;
  right: 0;
  background: #fff;
  padding: 20rpx 24rpx calc(20rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid #eee;
  box-shadow: 0 -8rpx 24rpx rgba(0, 0, 0, 0.06);
  z-index: 999;
}

.price-info {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 18rpx;
}

.price-label {
  font-size: 26rpx;
  color: #333;
}

.price-value {
  font-size: 40rpx;
  color: #c41e3a;
  font-weight: 800;
}

.action-buttons {
  display: flex;
  gap: 12rpx;
}

.action-btn {
  flex: 1;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 44rpx;
  font-size: 26rpx;
  font-weight: 700;
  border: none;
  padding: 0;
}

.reset-btn {
  flex: 0.75;
  background: #f5f5f5;
  color: #666;
  font-size: 26rpx;
  font-weight: 600;
}

.pay-btn {
  background: linear-gradient(135deg, #c41e3a, #e03e52);
  color: #fff;
  flex: 1.5;
}

.action-btn::after {
  border: none;
}

.type-item:active,
.size-item:active,
.paper-item:active,
.ai-hero:active {
  opacity: 0.92;
  transform: scale(0.99);
}
