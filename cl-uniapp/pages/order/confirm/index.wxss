/* 订单确认页面样式 */

.container {
  background: #f5f5f5;
  min-height: 100vh;
  padding-bottom: 120rpx;
}

.section {
  background: white;
  margin-top: 20rpx;
  padding: 30rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
}

/* 地址卡片样式 */
.address-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 30rpx;
  background: #fff;
  border-radius: 10rpx;
  border: 1px solid #eee;
  margin-bottom: 20rpx;
}

.address-info {
  flex: 1;
}

.address-header {
  display: flex;
  align-items: center;
  margin-bottom: 15rpx;
}

.receiver-name {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-right: 20rpx;
}

.receiver-phone {
  font-size: 28rpx;
  color: #666;
}

.address-detail {
  font-size: 28rpx;
  color: #666;
  line-height: 1.6;
}

.address-arrow {
  margin-left: 20rpx;
}

.arrow {
  font-size: 48rpx;
  color: #999;
}

/* 添加地址按钮 */
.add-address {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 60rpx 30rpx;
  background: #fff;
  border-radius: 10rpx;
  border: 2px dashed #ddd;
  margin-bottom: 20rpx;
}

.add-icon {
  font-size: 60rpx;
  color: #c33c2f;
  margin-bottom: 10rpx;
}

.add-text {
  font-size: 28rpx;
  color: #666;
}

/* 手动输入区域 */
.manual-input {
  margin-top: 20rpx;
}

.form-item {
  display: flex;
  align-items: center;
  margin-bottom: 30rpx;
}

.label {
  font-size: 28rpx;
  color: #333;
  width: 150rpx;
}

.input {
  flex: 1;
  font-size: 28rpx;
  border: 1px solid #ddd;
  padding: 10rpx 20rpx;
  border-radius: 5rpx;
}

.textarea {
  flex: 1;
  font-size: 28rpx;
  border: 1px solid #ddd;
  padding: 10rpx 20rpx;
  border-radius: 5rpx;
  min-height: 150rpx;
}

.goods-item {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
  padding-bottom: 20rpx;
  border-bottom: 1px solid #f0f0f0;
}

.goods-item:last-child {
  margin-bottom: 0;
  padding-bottom: 0;
  border-bottom: none;
}

.goods-image {
  width: 150rpx;
  height: 150rpx;
  border-radius: 10rpx;
  margin-right: 20rpx;
}

.goods-info {
  flex: 1;
}

.goods-name {
  font-size: 28rpx;
  color: #333;
  display: block;
  margin-bottom: 10rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.goods-spec {
  font-size: 24rpx;
  color: #999;
  display: block;
  margin-bottom: 8rpx;
}

.goods-price {
  font-size: 28rpx;
  color: #666;
  display: block;
}

.goods-subtotal {
  display: flex;
  align-items: center;
}

.subtotal {
  font-size: 32rpx;
  color: #c33c2f;
  font-weight: bold;
}

.amount-item {
  display: flex;
  justify-content: space-between;
  padding: 20rpx 0;
  border-bottom: 1px solid #eee;
}

.amount-item.total {
  border-bottom: none;
  font-size: 32rpx;
  font-weight: bold;
  color: #c33c2f;
}

.footer {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: white;
  padding: 20rpx;
  border-top: 1px solid #eee;
}

.submit-btn {
  width: 100%;
  height: 80rpx;
  line-height: 80rpx;
  background: #c33c2f;
  color: white;
  border-radius: 10rpx;
  font-size: 32rpx;
  padding: 0;
}
