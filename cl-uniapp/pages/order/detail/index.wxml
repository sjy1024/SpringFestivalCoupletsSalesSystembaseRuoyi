<!-- 订单详情页面 -->
<view class="container">
  <!-- 订单状态卡片 -->
  <view class="status-card">
    <view class="status-header">
      <text class="status-text status-{{order.status}}">
        {{order.statusName || getStatusText(order.status)}}
      </text>
    </view>
    
    <!-- 状态信息区域 -->
    <view class="status-info">
      <!-- 支付状态 -->
      <view class="status-section">
        <view class="status-label">支付状态</view>
        <view class="status-value">
          <text wx:if="{{order.status === '0'}}" class="status-unpaid">待支付</text>
          <text wx:else class="status-paid">已支付</text>
        </view>
      </view>
      
      <!-- 订单制作状态 -->
      <view class="status-section">
        <view class="status-label">制作状态</view>
        <view class="status-value">
          <text wx:if="{{order.status === '0'}}" class="status-waiting">等待支付</text>
          <text wx:elif="{{order.status === '1'}}" class="status-pending">待制作</text>
          <text wx:elif="{{order.status === '2'}}" class="status-processing">制作中</text>
          <text wx:elif="{{order.status === '3'}}" class="status-completed">已完成</text>
          <text wx:else class="status-canceled">已取消</text>
        </view>
      </view>
    </view>
    
    <!-- 订单信息 -->
    <view class="order-info-row">
      <text class="order-no">订单号：{{order.orderNo || '加载中...'}}</text>
    </view>
    <view wx:if="{{order.createTime}}" class="order-info-row">
      <text class="order-time">下单时间：{{order.createTimeDisplay}}</text>
    </view>
  </view>

  <!-- 收货信息 -->
  <view class="section">
    <view class="section-title">收货信息</view>
    <view class="info-item">
      <text class="label">收货人</text>
      <text class="value">{{order.receiverName || '-'}}</text>
    </view>
    <view class="info-item">
      <text class="label">电话</text>
      <text class="value">{{order.receiverPhone || '-'}}</text>
    </view>
    <view class="info-item">
      <text class="label">地址</text>
      <text class="value">{{order.receiverAddress || '-'}}</text>
    </view>
  </view>

  <!-- 商品信息 -->
  <view class="section">
    <view class="section-title">商品信息</view>
    <view wx:if="{{items.length > 0}}">
      <view wx:for="{{items}}" wx:key="itemId" class="goods-item">
        <view class="goods-info">
          <text class="goods-name">{{item.goodsName}}</text>
          <text wx:if="{{item.specText}}" class="goods-spec">{{item.specText}}</text>
          <view class="goods-detail">
            <text class="goods-price">¥{{item.goodsPrice}} × {{item.quantity}}</text>
            <text class="goods-total">¥{{item.totalPrice}}</text>
          </view>
        </view>
      </view>
    </view>
    <view wx:else class="empty-goods">
      <text>暂无商品信息</text>
    </view>
  </view>

  <!-- 支付信息 -->
  <view class="section">
    <view class="section-title">支付信息</view>
    <view class="amount-item">
      <text class="label">商品金额</text>
      <text class="value">¥{{order.totalAmount || 0}}</text>
    </view>
    <view class="amount-item">
      <text class="label">运费</text>
      <text class="value">免运费</text>
    </view>
    <view class="amount-item highlight">
      <text class="label">实付金额</text>
      <text class="value price">¥{{order.totalAmount || 0}}</text>
    </view>
    <view wx:if="{{order.status !== '0'}}" class="amount-item">
      <text class="label">支付方式</text>
      <text class="value">模拟支付</text>
    </view>
    <view wx:if="{{order.status !== '0' && order.updateTime}}" class="amount-item">
      <text class="label">支付时间</text>
      <text class="value">{{order.payTimeDisplay}}</text>
    </view>
  </view>

  <!-- 订单备注 -->
  <view wx:if="{{order.remark}}" class="section">
    <view class="section-title">订单备注</view>
    <view class="remark-text">{{order.remark}}</view>
  </view>

  <!-- 取消审核提示 -->
  <view wx:if="{{order.cancelStatus === '1'}}" class="cancel-audit-banner">
    <text class="cancel-audit-title">取消申请审核中</text>
    <text class="cancel-audit-desc">商家正在处理，请耐心等待</text>
  </view>
  <view wx:elif="{{order.cancelStatus === '3'}}" class="cancel-audit-banner reject">
    <text class="cancel-audit-title">取消申请未通过</text>
    <text class="cancel-audit-desc" wx:if="{{order.cancelReason}}">{{order.cancelReason}}</text>
  </view>

  <!-- 已支付/制作中：智能定制入口 -->
  <view wx:if="{{order.status === '1' || order.status === '2'}}" class="smart-custom-entry" bindtap="goSmartCustom">
    <view class="smart-custom-entry__text">
      <view class="smart-custom-entry__title">智能定制春联</view>
      <view class="smart-custom-entry__desc">为本单填写上联、下联、横批并提交</view>
    </view>
    <text class="smart-custom-arrow">›</text>
  </view>

  <!-- 操作按钮 -->
  <view class="footer">
    <!-- 待支付 -->
    <view wx:if="{{order.status === '0'}}" class="button-group row-btns">
      <button bindtap="handleCancelOrder" class="action-btn cancel-btn" disabled="{{loading}}">取消订单</button>
      <button bindtap="payOrder" class="action-btn pay-btn flex-btn" disabled="{{loading}}">
        {{loading ? '处理中...' : '立即支付'}}
      </button>
    </view>

    <!-- 已支付/制作中 -->
    <view wx:elif="{{order.status === '1' || order.status === '2'}}" class="button-group">
      <view wx:if="{{order.cancelStatus !== '1'}}" class="row-btns">
        <button bindtap="handleCancelOrder" class="action-btn cancel-btn" disabled="{{loading}}">申请取消</button>
        <button bindtap="confirmReceive" class="action-btn receive-btn flex-btn" disabled="{{loading}}">
          确认收货
        </button>
      </view>
      <view wx:else class="status-tip pending">取消申请已提交，等待商家确认</view>
    </view>
    
    <!-- 已收货 -->
    <view wx:elif="{{order.status === '3'}}" class="button-group">
      <view class="status-tip success">订单已完成，感谢您的购买！</view>
    </view>
    
    <!-- 已取消 -->
    <view wx:elif="{{order.status === '4'}}" class="button-group">
      <view class="status-tip cancel">订单已取消</view>
    </view>
    
    <button bindtap="goOrderList" class="action-btn back-btn">返回订单列表</button>
  </view>
</view>
